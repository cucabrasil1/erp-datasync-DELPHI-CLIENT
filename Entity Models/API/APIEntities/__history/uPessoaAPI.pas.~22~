function TPessoaAPI.ToJson: TJSONObject;
var
  Arr: TJSONArray;
  C: TPessoaContato;
  E: TPessoaEndereco;
  D: TPessoaDadosBancarios;
begin
  Result := TJSONObject.Create;

  Result.AddPair('codigoerp',               StrOrNull(codigoerp));
  Result.AddPair('nome',                    StrOrNull(nome));
  Result.AddPair('nomefantasia',            StrOrNull(nomefantasia));
  Result.AddPair('logradouro',              StrOrNull(logradouro));
  Result.AddPair('numero',                  StrOrNull(numero));
  Result.AddPair('bairro',                  StrOrNull(bairro));
  Result.AddPair('cidade',                  StrOrNull(cidade));
  Result.AddPair('uf',                      StrOrNull(uf));
  Result.AddPair('cep',                     CleanNumOrNull(cep));
  Result.AddPair('ibge',                    StrOrNull(ibge));
  Result.AddPair('complemento',             StrOrNull(complemento));
  Result.AddPair('documentoprincipal',      CleanDocOrNull(documentoprincipal));
  Result.AddPair('documentosecundario',     CleanDocOrNull(documentosecundario));
  Result.AddPair('telefone',                CleanNumOrNull(telefone));
  Result.AddPair('celular',                 CleanNumOrNull(celular));
  Result.AddPair('email',                   StrOrNull(email));
  Result.AddPair('observacoes',             StrOrNull(observacoes));
  Result.AddPair('sexo',                    StrOrNull(sexo));
  Result.AddPair('tipopessoa',              StrOrNull(tipopessoa));
  Result.AddPair('habilitado',              TJSONNumber.Create(habilitado));
  Result.AddPair('ativo',                   TJSONNumber.Create(ativo));
  Result.AddPair('perfilcliente',           PerfilOrNull(perfilcliente));
  Result.AddPair('perfilfornecedor',        PerfilOrNull(perfilfornecedor));
  Result.AddPair('perfiltransportador',     PerfilOrNull(perfiltransportador));
  Result.AddPair('perfilfuncionario',       PerfilOrNull(perfilfuncionario));
  Result.AddPair('perfilvendedor',          PerfilOrNull(perfilvendedor));
  Result.AddPair('perfilsupervisor',        PerfilOrNull(perfilsupervisor));
  Result.AddPair('datafundacaonascimento',  StrOrNull(datafundacaonascimento));
  Result.AddPair('datacadastro',            StrOrNull(datacadastro));
  Result.AddPair('dataultimacompra',        StrOrNull(dataultimacompra));
  Result.AddPair('rntrc_transportador',     StrOrNull(rntrc_transportador));

  Result.AddPair('idclientegrupo',          StrOrNull(idclientegrupo));
  Result.AddPair('idclienteregiao',         StrOrNull(idclienteregiao));

  Arr := TJSONArray.Create;
  for C in FContatos do
    Arr.AddElement(C.ToJson);
  Result.AddPair('contatos',                Arr);

  Arr := TJSONArray.Create;
  for E in FEnderecos do
    Arr.AddElement(E.ToJson);
  Result.AddPair('enderecos',               Arr);

  Arr := TJSONArray.Create;
  for D in FDadosBancarios do
    Arr.AddElement(D.ToJson);
  Result.AddPair('dadosbancarios',          Arr);

  if (perfilfuncionario <> 0) and (FComplementoFuncionario <> nil) then
    Result.AddPair('complementofuncionario', FComplementoFuncionario.ToJson);
end;

{ TPessoaAPI.FromJson }

procedure TPessoaAPI.FromJson(AJson: TJSONObject);
var
  Arr: TJSONArray;
  Obj: TJSONObject;
  i: Integer;
  C: TPessoaContato;
  E: TPessoaEndereco;
  D: TPessoaDadosBancarios;
begin
  id                      := JsonStrOrEmpty('id', AJson);
  tenant_id               := JsonStrOrEmpty('tenant_id', AJson);
  codigoerp               := JsonStrOrEmpty('codigoerp', AJson);
  nome                    := JsonStrOrEmpty('nome', AJson);
  nomefantasia            := JsonStrOrEmpty('nomefantasia', AJson);
  logradouro              := JsonStrOrEmpty('logradouro', AJson);
  numero                  := JsonStrOrEmpty('numero', AJson);
  bairro                  := JsonStrOrEmpty('bairro', AJson);
  cidade                  := JsonStrOrEmpty('cidade', AJson);
  uf                      := JsonStrOrEmpty('uf', AJson);
  cep                     := JsonStrOrEmpty('cep', AJson);
  ibge                    := JsonStrOrEmpty('ibge', AJson);
  complemento             := JsonStrOrEmpty('complemento', AJson);
  documentoprincipal      := JsonStrOrEmpty('documentoprincipal', AJson);
  documentosecundario     := JsonStrOrEmpty('documentosecundario', AJson);
  telefone                := JsonStrOrEmpty('telefone', AJson);
  celular                 := JsonStrOrEmpty('celular', AJson);
  email                   := JsonStrOrEmpty('email', AJson);
  observacoes             := JsonStrOrEmpty('observacoes', AJson);
  sexo                    := JsonStrOrEmpty('sexo', AJson);
  tipopessoa              := JsonStrOrEmpty('tipopessoa', AJson);
  habilitado              := JsonIntOrZero('habilitado', AJson);
  ativo                   := JsonIntOrZero('ativo', AJson);
  perfilcliente           := JsonIntOrZero('perfilcliente', AJson);
  perfilfornecedor        := JsonIntOrZero('perfilfornecedor', AJson);
  perfiltransportador     := JsonIntOrZero('perfiltransportador', AJson);
  perfilfuncionario       := JsonIntOrZero('perfilfuncionario', AJson);
  perfilvendedor          := JsonIntOrZero('perfilvendedor', AJson);
  perfilsupervisor        := JsonIntOrZero('perfilsupervisor', AJson);
  datafundacaonascimento  := JsonStrOrEmpty('datafundacaonascimento', AJson);
  datacadastro            := JsonStrOrEmpty('datacadastro', AJson);
  dataultimacompra        := JsonStrOrEmpty('dataultimacompra', AJson);
  rntrc_transportador     := JsonStrOrEmpty('rntrc_transportador', AJson);
  is_deleted              := JsonIntOrZero('is_deleted', AJson);
  deleted_at              := JsonStrOrEmpty('deleted_at', AJson);
  synced_at               := JsonStrOrEmpty('synced_at', AJson);
  created_at              := JsonStrOrEmpty('created_at', AJson);
  updated_at              := JsonStrOrEmpty('updated_at', AJson);

  if AJson.TryGetValue('contatos', Arr) then
    for i := 0 to Arr.Count - 1 do
    begin
      C := TPessoaContato.Create;
      C.FromJson(TJSONObject(Arr.Items[i]));
      FContatos.Add(C);
    end;

  if AJson.TryGetValue('enderecos', Arr) then
    for i := 0 to Arr.Count - 1 do
    begin
      E := TPessoaEndereco.Create;
      E.FromJson(TJSONObject(Arr.Items[i]));
      FEnderecos.Add(E);
    end;

  if AJson.TryGetValue('dadosbancarios', Arr) then
    for i := 0 to Arr.Count - 1 do
    begin
      D := TPessoaDadosBancarios.Create;
      D.FromJson(TJSONObject(Arr.Items[i]));
      FDadosBancarios.Add(D);
    end;

  if AJson.TryGetValue('complementofuncionario', Obj) then
  begin
    FComplementoFuncionario := TFuncionarioComplemento.Create;
    FComplementoFuncionario.FromJson(Obj);
  end;
end;
end.

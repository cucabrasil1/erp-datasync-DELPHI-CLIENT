end;

constructor TPessoaAPI.Create;
begin
  inherited;
  FContatos               := TObjectList<TPessoaContato>.Create(True);
  FEnderecos              := TObjectList<TPessoaEndereco>.Create(True);
  FDadosBancarios          := TObjectList<TPessoaDadosBancarios>.Create(True);
  FComplementoFuncionario   := nil;
end;

destructor TPessoaAPI.Destroy;
begin
  FContatos.Free;
  FEnderecos.Free;
  FDadosBancarios.Free;
  FComplementoFuncionario.Free;
  inherited;
end;

procedure TPessoaAPI.AddContato(const ANome, ATelefone, AEmail, ADepartamento: string);
var
  vTel: string;
  C: TPessoaContato;
begin
  vTel := TRegEx.Replace(ATelefone, '[^0-9]', '');

  if (vTel = '') and (Trim(ANome) = '') and (Trim(AEmail) = '') and (Trim(ADepartamento) = '') then
    Exit;

  C               := TPessoaContato.Create;

  C.nome          := ANome;
  C.telefone      := vTel;
  C.email         := AEmail;
  C.departamento  := ADepartamento;

  FContatos.Add(C);
end;

procedure TPessoaAPI.AddEndereco(const ALogradouro, ANumero, AComplemento,
  ABairro, ACidade, AUf, ACep, ADescricao, AObservacoes: string);
var
  E: TPessoaEndereco;
begin
  E             := TPessoaEndereco.Create;

  E.logradouro  := ALogradouro;
  E.numero      := ANumero;
  E.complemento := AComplemento;
  E.bairro      := ABairro;
  E.cidade      := ACidade;
  E.uf          := AUf;
  E.cep         := ACep;
  E.descricao   := ADescricao;
  E.observacoes := AObservacoes;

  FEnderecos.Add(E);
end;

procedure TPessoaAPI.AddDadosBancarios(const ACodigoErp, ACodBanco, ATitular, AAgencia,
  ANumeroconta, ADigito, AChavePix, ATipoChavePix, ATipoConta: string);

  function MapTipoChavePix(const AErp: string): string;
  begin
    if AErp = 'CELULAR' then
      Result := 'TELEFONE'
    else if AErp = 'ALEATÓRIA' then
      Result := 'CHAVEALEATORIA'
    else if AErp = 'E-MAIL' then
      Result := 'EMAIL'
    else if (AErp = 'CPF/CNPJ') or (AErp = 'CPF') or (AErp = 'CNPJ') then
      Result := 'DOCUMENTO'
    else
      Result := AErp;
  end;

var
  D: TPessoaDadosBancarios;
begin
  if (Trim(AChavePix) = '') and (Trim(ANumeroconta) = '') then
    Exit;

  D                := TPessoaDadosBancarios.Create;
  D.codigoerp      := ACodigoErp;
  D.codbanco       := ACodBanco;
  D.titular        := ATitular;
  D.agencia        := AAgencia;
  D.numeroconta  := ANumeroconta;
  D.digito         := ADigito;
  D.chavepix       := AChavePix;
  D.tipochavepix   := MapTipoChavePix(ATipoChavePix);
  D.tipoconta      := ATipoConta;
  FDadosBancarios.Add(D);
end;

